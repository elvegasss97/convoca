# Copia este archivo a `.env` (desarrollo) o configura estas mismas
# variables en el panel de tu proveedor de hosting (staging/producción).
# Nunca pongas valores reales de staging/producción en este archivo:
# solo sirve como plantilla y se versiona en git.

# --- Entorno declarado -------------------------------------------------
# Controla qué se carga. "production" desactiva SIEMPRE los datos demo y
# las herramientas de desarrollo, pase lo que digan las dos variables de
# abajo (ver src/lib/config/env.ts) — es una salvaguarda, no una opción.
PUBLIC_APP_ENV=development

# --- Datos y herramientas de desarrollo --------------------------------
# Solo tienen efecto si PUBLIC_APP_ENV no es "production".
PUBLIC_ENABLE_DEMO_DATA=true
PUBLIC_ENABLE_DEV_TOOLS=true

# --- Supabase (cliente) -------------------------------------------------
# Claves PÚBLICAS únicamente (publishable key, el nombre actual de lo que
# antes se llamaba "anon key"). La secret key / service_role key NUNCA debe
# vivir aquí ni en ninguna variable PUBLIC_*: solo en el entorno del
# servidor, y solo si en el futuro hiciera falta una operación de servidor
# (ver el apartado de variables de servidor en MIGRACION-PRODUCCION.md).
PUBLIC_SUPABASE_URL=https://tu-proyecto-ficticio.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_valor_ficticio_de_ejemplo
