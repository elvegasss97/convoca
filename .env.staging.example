# Plantilla de variables para el entorno de STAGING (Vercel Preview).
# No se usa como archivo de entorno real: cópialas a mano al panel de
# Vercel (Project Settings → Environment Variables → entorno "Preview"),
# sustituyendo los valores ficticios de Supabase por los reales de tu
# proyecto. Nunca pongas aquí valores reales — este archivo se versiona.

# Staging es HTTPS y accesible por URL, aunque no esté anunciado
# públicamente: por eso lleva la misma postura que producción (sin datos
# demo, sin herramientas de desarrollo, sin login por contraseña) y no la
# de development.
PUBLIC_APP_ENV=staging
PUBLIC_ENABLE_DEMO_DATA=false
PUBLIC_ENABLE_DEV_TOOLS=false
PUBLIC_AUTH_GOOGLE_ENABLED=true
PUBLIC_AUTH_PASSWORD_ENABLED=false

# Mismo proyecto de Supabase que development a menos que decidas crear uno
# de staging aparte. Claves PÚBLICAS únicamente — la secret key/service_role
# key nunca vive en variables PUBLIC_* ni en Vercel fuera de la Edge
# Function correspondiente.
PUBLIC_SUPABASE_URL=https://tu-proyecto-ficticio.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_valor_ficticio_de_ejemplo
