# Plantilla de variables para el entorno de PRODUCTION en Vercel.
# No se usa como archivo de entorno real: cópialas a mano al panel de
# Vercel (Project Settings → Environment Variables → entorno "Production"),
# sustituyendo los valores ficticios de Supabase por los reales de tu
# propio proyecto. Nunca pongas aquí valores reales — este archivo se
# versiona.
#
# Para tu propia instancia: antes de crear este entorno en Vercel, revisa
# `/seguridad` (Security Baseline P0) y confirma que tu propio proyecto
# de Supabase tiene aplicadas las migraciones de `supabase/migrations/`.

PUBLIC_APP_ENV=production
PUBLIC_ENABLE_DEMO_DATA=false
PUBLIC_ENABLE_DEV_TOOLS=false
PUBLIC_AUTH_GOOGLE_ENABLED=true
PUBLIC_AUTH_PASSWORD_ENABLED=false

# Claves PÚBLICAS únicamente — la secret key/service_role key nunca vive en
# variables PUBLIC_* ni en Vercel fuera de la Edge Function correspondiente.
PUBLIC_SUPABASE_URL=https://tu-proyecto-ficticio.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_valor_ficticio_de_ejemplo
