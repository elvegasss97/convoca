# Variables de entorno para `pnpm test` (vitest). Se versiona en git (ver
# excepción en .gitignore): por eso NUNCA debe llevar credenciales reales,
# solo valores con forma válida para que los módulos que crean un cliente
# de Supabase al importarse (p. ej. `$lib/supabase/client.ts`) no fallen al
# arrancar. Los tests unitarios de este proyecto no hacen ninguna llamada
# de red real a Supabase, así que estos valores nunca se usan de verdad.
PUBLIC_APP_ENV=development
PUBLIC_ENABLE_DEMO_DATA=false
PUBLIC_ENABLE_DEV_TOOLS=false
PUBLIC_AUTH_GOOGLE_ENABLED=true
PUBLIC_AUTH_PASSWORD_ENABLED=true
PUBLIC_SUPABASE_URL=https://test-placeholder.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test_placeholder
